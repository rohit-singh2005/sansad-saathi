# ============================================================
#  SansadSaathi — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the .env file to version control!
# ============================================================

# ── LLM API Keys ──────────────────────────────────────────
# Google Gemini API key (primary LLM provider)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (free fallback LLM provider — llama-3.3-70b)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── News API ───────────────────────────────────────────────
# NewsAPI.org key for live parliamentary news feed
# Get yours at: https://newsapi.org/register
VITE_NEWS_API_KEY=your_newsapi_key_here

# ── Data Paths ─────────────────────────────────────────────
# Absolute path to the directory containing:
#   - faiss-001.index  (~2.3 GB)
#   - metadata.pkl     (~1.25 GB)
# Download instructions: see README.md → Dataset section
SANSAD_DATA_PATH=/path/to/your/sansad_data
